# GPQA CMAB MVP configuration
LOG_LEVEL=INFO

# ─── LLM provider ────────────────────────────────────────────────────────
# Supported values:
#   mock                              Deterministic offline mock (default).
#   openai | openai_compatible        Any OpenAI-API-compatible endpoint.
#       Set OPENAI_BASE_URL (or LLM_BASE_URL) to point at vLLM, Ollama,
#       Together, Groq, OpenRouter, Anyscale, Fireworks, DeepSeek, xAI,
#       Mistral, Perplexity, LM Studio, etc.
#   azure_openai                      Azure OpenAI deployments.
LLM_PROVIDER=mock

# Models (deployment names for Azure)
MAIN_MODEL=gpt-4o-mini
SUBAGENT_MODEL=gpt-4o-mini
SELF_CONSISTENCY_MODEL=gpt-4o-mini

# Reasoning effort for OpenAI reasoning models (o1, o3, gpt-5 series) and
# many OpenAI-compatible providers. Leave empty for non-reasoning models.
# Valid values: minimal | low | medium | high
# When set, the client sends `reasoning_effort=<value>` and OMITS temperature
# (reasoning models reject non-default temperature).
REASONING_EFFORT=

# ─── OpenAI-API-compatible endpoint configuration ────────────────────────
# Required for "openai" / "openai_compatible". Optional for self-hosted
# servers that do not require authentication.
OPENAI_API_KEY=
# Alternative name accepted by self-hosted servers:
LLM_API_KEY=
# Base URL examples (uncomment and edit one):
#   OpenAI:        (omit; defaults to https://api.openai.com/v1)
#   Together:      OPENAI_BASE_URL=https://api.together.xyz/v1
#   Groq:          OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Anyscale:      OPENAI_BASE_URL=https://api.endpoints.anyscale.com/v1
#   Fireworks:     OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#   DeepSeek:      OPENAI_BASE_URL=https://api.deepseek.com/v1
#   xAI:           OPENAI_BASE_URL=https://api.x.ai/v1
#   Mistral:       OPENAI_BASE_URL=https://api.mistral.ai/v1
#   Perplexity:    OPENAI_BASE_URL=https://api.perplexity.ai
#   Local vLLM:    OPENAI_BASE_URL=http://localhost:8000/v1
#   Local Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
# Or a generic alias if you prefer not to overload the OpenAI name:
LLM_BASE_URL=
OPENAI_ORGANIZATION=

# ─── Azure OpenAI configuration ──────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ─── Cross-provider HTTP knobs ───────────────────────────────────────────
# Optional default headers for the LLM HTTP client. Accepts a JSON object
# or a comma-separated key=value list, e.g.:
#   LLM_DEFAULT_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"gpqa"}
#   LLM_DEFAULT_HEADERS=HTTP-Referer=https://example.com,X-Title=gpqa
LLM_DEFAULT_HEADERS=
# Per-request timeout in seconds.
LLM_TIMEOUT_S=

# ─── Cost-aware utility defaults ─────────────────────────────────────────
LAMBDA_TOKEN=0.05
LAMBDA_CALL=0.01
