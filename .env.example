# GPQA CMAB MVP configuration
LOG_LEVEL=INFO

# ─── LLM provider ────────────────────────────────────────────────────────
# Supported values:
#   mock                              Deterministic offline mock (default).
#   openai | openai_compatible        Any OpenAI-API-compatible endpoint.
#       Set OPENAI_BASE_URL (or LLM_BASE_URL) to point at vLLM, Ollama,
#       Together, Groq, OpenRouter, Anyscale, Fireworks, DeepSeek, xAI,
#       Mistral, Perplexity, LM Studio, etc.
#   azure_openai                      Azure OpenAI deployments.
LLM_PROVIDER=mock

# Models (deployment names for Azure)
MAIN_MODEL=gpt-4o-mini
SUBAGENT_MODEL=gpt-4o-mini
SELF_CONSISTENCY_MODEL=gpt-4o-mini

# Reasoning effort for OpenAI reasoning models (gpt-5.x, o-series) and many
# OpenAI-compatible providers. Leave empty for non-reasoning models.
# Valid values: none | minimal | low | medium | high | xhigh
# When set, the client sends reasoning effort to the model and OMITS the
# temperature parameter (reasoning models reject non-default temperature).
REASONING_EFFORT=

# Use OpenAI's newer Responses API instead of Chat Completions. OpenAI
# recommends Responses for reasoning models. Auto-enabled when
# REASONING_EFFORT is set AND the endpoint is api.openai.com (or unset).
# Most non-OpenAI providers do not implement /responses; set to false there.
# Values: true | false (omit for auto policy).
LLM_USE_RESPONSES_API=

# Cap the number of output tokens (reasoning + visible response). Maps to
# `max_tokens` on Chat Completions and `max_output_tokens` on Responses.
# OpenAI recommends reserving at least ~25000 for reasoning + output when
# experimenting with reasoning models.
MAX_OUTPUT_TOKENS=

# ─── OpenAI-API-compatible endpoint configuration ────────────────────────
# Required for "openai" / "openai_compatible". Optional for self-hosted
# servers that do not require authentication.
OPENAI_API_KEY=
# Alternative name accepted by self-hosted servers:
LLM_API_KEY=

# Multiple EQUIVALENT API keys for RPM load balancing. Use this when one key
# hits per-minute request limits. All keys MUST belong to the same provider,
# org, and have access to the same models. Comma-, newline-, or whitespace-
# separated. Takes precedence over OPENAI_API_KEY when set.
#   OPENAI_API_KEYS=sk-aaa...,sk-bbb...,sk-ccc...
OPENAI_API_KEYS=
# When a key hits a 429 RateLimitError, park it for this many seconds before
# trying it again. The pool also honors the `retry-after` response header and
# the provider-specific "try again in X.Ys" body hint, preferring the
# server-supplied value when present. Default: 30.
OPENAI_KEY_COOLDOWN_S=30
# When ALL keys in the pool are simultaneously parked (e.g. single-key pool
# or multiple keys sharing an org-wide TPM bucket), the pool sleeps until the
# soonest key becomes free and retries — bounded by these two budgets:
#   OPENAI_MAX_RETRIES: max number of 429s tolerated per request (default 6)
#   OPENAI_MAX_WAIT_S:  total wall-clock budget for sleeps per request
#                       (default 120)
OPENAI_MAX_RETRIES=6
OPENAI_MAX_WAIT_S=120
# Base URL examples (uncomment and edit one):
#   OpenAI:        (omit; defaults to https://api.openai.com/v1)
#   Together:      OPENAI_BASE_URL=https://api.together.xyz/v1
#   Groq:          OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Anyscale:      OPENAI_BASE_URL=https://api.endpoints.anyscale.com/v1
#   Fireworks:     OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#   DeepSeek:      OPENAI_BASE_URL=https://api.deepseek.com/v1
#   xAI:           OPENAI_BASE_URL=https://api.x.ai/v1
#   Mistral:       OPENAI_BASE_URL=https://api.mistral.ai/v1
#   Perplexity:    OPENAI_BASE_URL=https://api.perplexity.ai
#   Local vLLM:    OPENAI_BASE_URL=http://localhost:8000/v1
#   Local Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
# Or a generic alias if you prefer not to overload the OpenAI name:
LLM_BASE_URL=
OPENAI_ORGANIZATION=

# ─── Azure OpenAI configuration ──────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ─── Cross-provider HTTP knobs ───────────────────────────────────────────
# Optional default headers for the LLM HTTP client. Accepts a JSON object
# or a comma-separated key=value list, e.g.:
#   LLM_DEFAULT_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"gpqa"}
#   LLM_DEFAULT_HEADERS=HTTP-Referer=https://example.com,X-Title=gpqa
LLM_DEFAULT_HEADERS=
# Per-request timeout in seconds.
LLM_TIMEOUT_S=

# ─── Cost-aware utility defaults ─────────────────────────────────────────
LAMBDA_TOKEN=0.05
LAMBDA_CALL=0.01
